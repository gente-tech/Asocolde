				'not null' => TRUE,
			],
			'zoho_request_id' => [
				'description' => 'Request ID de Zoho Sign.',
				'type' => 'varchar',
				'length' => 100,
				'not null' => TRUE,
				'default' => '',
			],
			'zoho_action_id' => [
				'description' => 'Action ID de Zoho Sign.',
				'type' => 'varchar',
				'length' => 100,
				'not null' => FALSE,
