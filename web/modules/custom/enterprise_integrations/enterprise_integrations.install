			'recipient_name' => [
				'description' => 'Nombre del firmante.',
				'type' => 'varchar',
				'length' => 255,
				'not null' => FALSE,
			],
			'recipient_email' => [
				'description' => 'Correo del firmante.',
				'type' => 'varchar',
				'length' => 255,
				'not null' => FALSE,
			],
			'status' => [
				'description' => 'Estado local del request en Drupal.',
				'type' => 'varchar',
				'length' => 50,
				'not null' => TRUE,
				'default' => 'pending',
			],
			'requested_at' => [
				'description' => 'Timestamp de creación del request en Zoho.',
				'type' => 'int',
				'unsigned' => TRUE,
				'not null' => FALSE,
			],
			'signed_at' => [
				'description' => 'Timestamp de firma detectada.',
				'type' => 'int',
				'unsigned' => TRUE,
