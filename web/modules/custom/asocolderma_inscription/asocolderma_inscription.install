  // Mostrar campos clave por defecto.
  $view_display->setComponent('field_solicitud_id', ['type' => 'string']);
  $view_display->setComponent('field_state', ['type' => 'list_default']);
  $view_display->setComponent('field_sg_reason', ['type' => 'basic_string']);
  $view_display->save();
}

function asocolderma_inscription_update_9003(): void
{
  $type = 'solicitud_ingreso';

  $form_display = EntityFormDisplay::load("node.$type.default");
  if (!$form_display) {
    $form_display = EntityFormDisplay::create([
      'targetEntityType' => 'node',
      'bundle' => $type,
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }

  $fields = [
    'field_adj_aut_verificacion',
    'field_adj_carta_1',
    'field_adj_carta_2',
    'field_adj_carta_ingreso',
    'field_adj_cert_publicacion',
    'field_adj_diploma_dermatologo',
    'field_adj_diploma_medico',
    'field_adj_hv',
    'field_adj_id',
    'field_adj_rethus',
    'field_adj_rut',
  ];

  $weight = 50;
  foreach ($fields as $field_name) {
    $form_display->setComponent($field_name, [
      'type' => 'file_generic',
      'weight' => $weight++,
      'settings' => [
        'progress_indicator' => 'throbber',
      ],
    ]);
  }

  $form_display->save();
}

function asocolderma_inscription_schema()
{
  $schema['asocolderma_solicitud_historial'] = [
    'description' => 'Historial append-only de transiciones de estado de solicitudes.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'solicitud_nid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'from_tid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
      'to_tid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'actor_uid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'created' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'origin' => [
        'type' => 'varchar',
        'length' => 50,
        'not null' => TRUE,
        'default' => 'unknown',
      ],
      'comment' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
      ],
      'metadata' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
        'description' => 'JSON string con metadata técnica (ip, user_agent, etc.)',
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'idx_solicitud_created' => ['solicitud_nid', 'created'],
      'idx_to_created' => ['to_tid', 'created'],
      'idx_actor_created' => ['actor_uid', 'created'],
    ],
  ];

  return $schema;
}

/**
 * Update hook para crear tabla en sitios ya instalados.
 */
function asocolderma_inscription_update_9004(): void
{
  $schema = \Drupal::database()->schema();

  if ($schema->tableExists('asocolderma_solicitud_historial')) {
    return;
  }

  $table = asocolderma_inscription_schema()['asocolderma_solicitud_historial'];
  $schema->createTable('asocolderma_solicitud_historial', $table);
}

/**
 * Migra field_tipo_asociado de string a referencia de taxonomía.
 */
function asocolderma_inscription_update_9005(): void
{
  $entity_type = 'node';
  $bundle = 'solicitud_ingreso';
  $field_name = 'field_tipo_asociado';
  $vocabulary = 'tipo_de_asociado';

  $storage = FieldStorageConfig::loadByName($entity_type, $field_name);
  $field = FieldConfig::loadByName($entity_type, $bundle, $field_name);

  if ($storage && $storage->getType() === 'entity_reference') {
    return;
  }

  $connection = \Drupal::database();

  $backup = [];

  if ($connection->schema()->tableExists("node__{$field_name}")) {
    $records = $connection->select("node__{$field_name}", 'f')
      ->fields('f', ['entity_id', "{$field_name}_value"])
      ->execute()
      ->fetchAll();

    foreach ($records as $record) {
      $backup[(int) $record->entity_id] = (string) $record->{$field_name . '_value'};
    }
  }

  if ($field) {
    $field->delete();
  }

  if ($storage) {
    $storage->delete();
  }

  try {
    field_purge_batch(50);
  } catch (\Throwable $e) {
    \Drupal::logger('asocolderma_inscription')->warning(
      'No fue posible purgar completamente el campo @field durante la migración. Se continúa con la recreación del campo. Error: @message',
      [
        '@field' => $field_name,
        '@message' => $e->getMessage(),
      ]
    );
  }

  FieldStorageConfig::create([
    'field_name' => $field_name,
    'entity_type' => $entity_type,
    'type' => 'entity_reference',
    'settings' => [
      'target_type' => 'taxonomy_term',
    ],
    'cardinality' => 1,
    'translatable' => FALSE,
  ])->save();

  FieldConfig::create([
    'field_name' => $field_name,
    'entity_type' => $entity_type,
    'bundle' => $bundle,
    'label' => 'Tipo de asociado',
    'required' => TRUE,
    'settings' => [
      'handler' => 'default:taxonomy_term',
      'handler_settings' => [
        'target_bundles' => [
          $vocabulary => $vocabulary,
        ],
        'sort' => [
          'field' => 'weight',
          'direction' => 'ASC',
        ],
        'auto_create' => FALSE,
      ],
    ],
  ])->save();

  $form_display = EntityFormDisplay::load("{$entity_type}.{$bundle}.default");
  if ($form_display) {
    $form_display->setComponent($field_name, [
      'type' => 'options_select',
      'weight' => 10,
    ]);
    $form_display->save();
  }

  $view_display = EntityViewDisplay::load("{$entity_type}.{$bundle}.default");
  if ($view_display) {
    $view_display->setComponent($field_name, [
      'type' => 'entity_reference_label',
      'label' => 'above',
      'settings' => [
        'link' => FALSE,
      ],
    ]);
    $view_display->save();
  }

  if ($backup) {
    $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
    $node_storage = \Drupal::entityTypeManager()->getStorage('node');

    $terms = $term_storage->loadByProperties([
      'vid' => $vocabulary,
    ]);

    $term_map = [];
    foreach ($terms as $term) {
      $term_map[strtolower(trim($term->label()))] = $term->id();
    }

    foreach ($backup as $nid => $old_value) {
      $key = strtolower(trim($old_value));

      if ($key === '' || !isset($term_map[$key])) {
        continue;
      }

      $node = $node_storage->load($nid);
      if (!$node) {
        continue;
      }

      $node->set($field_name, [
        'target_id' => $term_map[$key],
      ]);
      $node->save();
    }
  }

  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
}

/**
 * Migra estado civil, sexo y tipo de documento a referencias de taxonomía.
 */
function asocolderma_inscription_update_9006(): void
{
  $fields = [
    'field_estado_civil' => [
      'label' => 'Estado civil',
      'vocabulary' => 'estado_civil',
      'weight' => 11,
    ],
    'field_sexo' => [
      'label' => 'Sexo',
      'vocabulary' => 'sexo',
      'weight' => 12,
    ],
    'field_tipo_documento' => [
      'label' => 'Tipo de documento',
      'vocabulary' => 'tipo_de_documento',
      'weight' => 13,
    ],
  ];

  foreach ($fields as $field_name => $definition) {
    asocolderma_inscription_migrate_string_field_to_taxonomy_reference(
      'node',
      'solicitud_ingreso',
      $field_name,
      $definition['label'],
      $definition['vocabulary'],
      $definition['weight']
    );
  }

  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
}

/**
 * Migra un campo string existente a referencia de taxonomía.
 */
function asocolderma_inscription_migrate_string_field_to_taxonomy_reference(
  string $entity_type,
  string $bundle,
  string $field_name,
  string $label,
  string $vocabulary,
  int $weight = 10,
): void {
  $storage = FieldStorageConfig::loadByName($entity_type, $field_name);
  $field = FieldConfig::loadByName($entity_type, $bundle, $field_name);

  if ($storage && $storage->getType() === 'entity_reference') {
    return;
  }

  $connection = \Drupal::database();
  $backup = [];

  if ($connection->schema()->tableExists("{$entity_type}__{$field_name}")) {
    $records = $connection->select("{$entity_type}__{$field_name}", 'f')
      ->fields('f', ['entity_id', "{$field_name}_value"])
      ->execute()
      ->fetchAll();

    foreach ($records as $record) {
      $backup[(int) $record->entity_id] = (string) $record->{$field_name . '_value'};
    }
  }

  try {
    if ($field) {
      $field->delete();
    }

    if ($storage) {
      $storage->delete();
    }

    field_purge_batch(50);
  } catch (\Throwable $e) {
    \Drupal::logger('asocolderma_inscription')->warning(
      'No fue posible purgar completamente el campo @field durante la migración. Se continúa con la recreación del campo. Error: @message',
      [
        '@field' => $field_name,
        '@message' => $e->getMessage(),
      ]
    );
  }

  FieldStorageConfig::create([
    'field_name' => $field_name,
    'entity_type' => $entity_type,
    'type' => 'entity_reference',
    'settings' => [
      'target_type' => 'taxonomy_term',
    ],
    'cardinality' => 1,
    'translatable' => FALSE,
  ])->save();

  FieldConfig::create([
    'field_name' => $field_name,
    'entity_type' => $entity_type,
    'bundle' => $bundle,
    'label' => $label,
    'required' => TRUE,
    'settings' => [
      'handler' => 'default:taxonomy_term',
      'handler_settings' => [
        'target_bundles' => [
          $vocabulary => $vocabulary,
        ],
        'sort' => [
          'field' => 'weight',
          'direction' => 'ASC',
        ],
        'auto_create' => FALSE,
      ],
    ],
  ])->save();

  $form_display = EntityFormDisplay::load("{$entity_type}.{$bundle}.default");
  if ($form_display) {
    $form_display->setComponent($field_name, [
      'type' => 'options_select',
      'weight' => $weight,
    ]);
    $form_display->save();
  }

  $view_display = EntityViewDisplay::load("{$entity_type}.{$bundle}.default");
  if ($view_display) {
    $view_display->setComponent($field_name, [
      'type' => 'entity_reference_label',
      'label' => 'above',
      'settings' => [
        'link' => FALSE,
      ],
    ]);
    $view_display->save();
  }

  if (!$backup) {
    return;
  }

  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $node_storage = \Drupal::entityTypeManager()->getStorage('node');

  $terms = $term_storage->loadByProperties([
    'vid' => $vocabulary,
  ]);

  $term_map = [];
  foreach ($terms as $term) {
    $term_map[strtolower(trim($term->label()))] = $term->id();
  }

  foreach ($backup as $nid => $old_value) {
    $key = strtolower(trim($old_value));

    if ($key === '' || !isset($term_map[$key])) {
      continue;
    }

    $node = $node_storage->load($nid);
    if (!$node) {
      continue;
    }

    $node->set($field_name, [
      'target_id' => $term_map[$key],
    ]);
    $node->save();
  }
}

/**
 * Migra país, departamento y ciudad de ejercicio a referencias de taxonomía.
 */
function asocolderma_inscription_update_9007(): void
{
  $fields = [
    'field_pais' => [
      'label' => 'País',
      'vocabulary' => 'country',
      'weight' => 14,
    ],
    'field_departamento' => [
      'label' => 'Departamento',
      'vocabulary' => 'departametos',
      'weight' => 15,
    ],
    'field_ciudad_ejercicio' => [
      'label' => 'Ciudad de ejercicio principal',
      'vocabulary' => 'city',
      'weight' => 16,
    ],
  ];

  foreach ($fields as $field_name => $definition) {
    asocolderma_inscription_migrate_string_field_to_taxonomy_reference(
      'node',
      'solicitud_ingreso',
      $field_name,
      $definition['label'],
      $definition['vocabulary'],
      $definition['weight']
    );
  }

  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
}

/**
 * Ajusta campos de dirección en solicitud de ingreso.
 */
function asocolderma_inscription_update_9008(): void
{
  $type = 'solicitud_ingreso';

  // Crear field_direccion si no existe.
  if (!FieldStorageConfig::loadByName('node', 'field_direccion')) {
    FieldStorageConfig::create([
      'field_name' => 'field_direccion',
      'entity_type' => 'node',
      'type' => 'string',
      'settings' => [
        'max_length' => 255,
      ],
      'cardinality' => 1,
      'translatable' => FALSE,
    ])->save();
  }

  if (!FieldConfig::loadByName('node', $type, 'field_direccion')) {
    FieldConfig::create([
      'field_name' => 'field_direccion',
      'entity_type' => 'node',
      'bundle' => $type,
      'label' => 'Dirección',
      'required' => TRUE,
      'settings' => [],
    ])->save();
  }

  // Ajustar label del campo ya existente.
  $field = FieldConfig::loadByName('node', $type, 'field_correspondencia_fisica');
  if ($field) {
    $field->setLabel('Dirección de correspondencia física');
    $field->setRequired(TRUE);
    $field->save();
  }

  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
}

/**
 * Agrega el campo de lugar de correspondencia a la solicitud de ingreso.
 */
function asocolderma_inscription_update_9009(): void
{
  $type = 'solicitud_ingreso';

  // Ajustar label del campo usado para Dirección física principal.
  $field_correspondencia = FieldConfig::loadByName('node', $type, 'field_correspondencia_fisica');
  if ($field_correspondencia) {
    $field_correspondencia->setLabel('Dirección física principal');
    $field_correspondencia->setRequired(TRUE);
    $field_correspondencia->save();
  }

  // Ajustar label del campo usado para Dirección institucional.
  $field_direccion_institucional = FieldConfig::loadByName('node', $type, 'field_direccion_institucional');
  if ($field_direccion_institucional) {
    $field_direccion_institucional->setLabel('Dirección institucional');
    $field_direccion_institucional->setRequired(TRUE);
    $field_direccion_institucional->save();
  }

  // Crear almacenamiento del campo taxonomy reference si no existe.
  if (!FieldStorageConfig::loadByName('node', 'field_lugar_correspondencia')) {
    FieldStorageConfig::create([
      'field_name' => 'field_lugar_correspondencia',
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'settings' => [
        'target_type' => 'taxonomy_term',
      ],
      'cardinality' => 1,
      'translatable' => FALSE,
    ])->save();
  }

  // Crear instancia del campo en solicitud_ingreso si no existe.
  if (!FieldConfig::loadByName('node', $type, 'field_lugar_correspondencia')) {
    FieldConfig::create([
      'field_name' => 'field_lugar_correspondencia',
      'entity_type' => 'node',
      'bundle' => $type,
      'label' => 'En caso de ser ratificado ¿Dónde desea recibir la correspondencia física?',
      'required' => TRUE,
      'settings' => [
        'handler' => 'default:taxonomy_term',
        'handler_settings' => [
          'target_bundles' => [
            'lugar_de_correspondencia' => 'lugar_de_correspondencia',
          ],
          'sort' => [
            'field' => 'name',
            'direction' => 'ASC',
          ],
          'auto_create' => FALSE,
          'auto_create_bundle' => '',
        ],
      ],
    ])->save();
  }

  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
}
