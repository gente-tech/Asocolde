{#
/**
 * Header profesional del flujo de aspirantes.
 */
#}

<header class="user-zone-app-header">
	<div class="user-zone-app-header__inner">

		<a href="/zona/solicitudes" class="user-zone-app-header__brand" aria-label="Ir a mis solicitudes">
			<img src="/sites/default/files/imageblock/logo-horizontal-pequeno.jpg" alt="AsoColDerma" class="user-zone-app-header__logo">
		</a>

		<button class="user-zone-app-header__hamburger" type="button" aria-expanded="false" aria-controls="user-zone-app-menu" data-user-zone-menu-toggle>
			<span class="user-zone-app-header__hamburger-line"></span>
			<span class="user-zone-app-header__hamburger-line"></span>
			<span class="user-zone-app-header__hamburger-line"></span>
			<span class="visually-hidden">Abrir menú</span>
		</button>

		<nav id="user-zone-app-menu" class="user-zone-app-menu" aria-label="Menú del aspirante">

			<div class="user-zone-app-menu__group user-zone-app-menu__group--single">
				<button class="user-zone-app-menu__trigger" type="button" data-user-zone-dropdown>
					Menú del aspirante
					<span class="user-zone-app-menu__chevron">⌄</span>
				</button>

				<div class="user-zone-app-menu__dropdown">
					{% for item in menu_items %}
						{% if not item.is_logout %}
							<a href="{{ item.url }}" class="user-zone-app-menu__dropdown-link{{ item.active ? ' is-active' : '' }}">
								{{ item.title }}
							</a>
						{% endif %}
					{% endfor %}
				</div>
			</div>

			<a href="{{ logout_url }}" class="user-zone-app-menu__logout" data-user-zone-logout-trigger>
				Cerrar sesión
			</a>

		</nav>

	</div>
</header>

<div class="user-zone-logout-modal" data-user-zone-logout-modal aria-hidden="true">
	<div class="user-zone-logout-modal__backdrop" data-user-zone-logout-cancel></div>

	<div class="user-zone-logout-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="user-zone-logout-title" aria-describedby="user-zone-logout-description">
		<div class="user-zone-logout-modal__icon">
			?
		</div>

		<h2 id="user-zone-logout-title" class="user-zone-logout-modal__title">
			¿Cerrar sesión?
		</h2>

		<p id="user-zone-logout-description" class="user-zone-logout-modal__text">
			Vas a salir de la zona del aspirante. Para continuar con tu proceso deberás iniciar sesión nuevamente.
		</p>

		<div class="user-zone-logout-modal__actions">
			<button type="button" class="user-zone-logout-modal__button user-zone-logout-modal__button--secondary" data-user-zone-logout-cancel>
				Cancelar
			</button>

			<a href="{{ logout_url }}" class="user-zone-logout-modal__button user-zone-logout-modal__button--primary" data-user-zone-logout-confirm>
				Sí, cerrar sesión
			</a>
		</div>
	</div>
</div>
