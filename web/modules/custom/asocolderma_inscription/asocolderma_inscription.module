<?php

use Drupal\node\NodeInterface;
use Drupal\taxonomy\Entity\Term;
use Drupal\block\BlockInterface;
use Drupal\Core\Access\AccessResult;
use Drupal\Core\Session\AccountInterface;

/**
 * Implements hook_theme().
 */
function asocolderma_inscription_theme($existing, $type, $theme, $path): array
{
  return [
    'asocolderma_inscription_user_zone_profile' => [
      'variables' => [
        'user_name' => NULL,
        'profile' => NULL,
        'edit_link' => NULL,
        'header_menu_items' => [],
        'logout_url' => NULL,
      ],
      'template' => 'asocolderma-inscription-user-zone-profile',
    ],
    'asocolderma_inscription_user_zone_requests' => [
      'variables' => [
        'user_name' => NULL,
        'requests' => [],
        'primary_action' => NULL,
        'has_active' => FALSE,
        'has_draft' => FALSE,
        'header_menu_items' => [],
        'logout_url' => NULL,
      ],
      'template' => 'asocolderma-inscription-user-zone-requests',
    ],
    'asocolderma_inscription_user_zone_header' => [
      'variables' => [
        'menu_items' => [],
        'logout_url' => NULL,
      ],
      'template' => 'asocolderma-inscription-user-zone-header',
    ],
  ];
}

function asocolderma_inscription_preprocess_node(array &$variables)
{
  if (empty($variables['node']) || !$variables['node'] instanceof NodeInterface) {
    return;
  }

  $node = $variables['node'];

  if ($node->bundle() !== 'solicitud_ingreso') {
    return;
  }

  $variables['semaforo_steps'] = asocolderma_inscription_build_semaforo_steps($node);

  $request = \Drupal::request();
  $session = $request->getSession();
  $referer = $request->headers->get('referer');

  if ($referer) {
    $host = $request->getSchemeAndHttpHost();

    if (str_starts_with($referer, $host)) {
      $referer_path = parse_url($referer, PHP_URL_PATH) ?: '/';
      $current_path = $request->getPathInfo();
      $internal_node_path = '/node/' . $node->id();
      $current_alias = \Drupal::service('path_alias.manager')->getAliasByPath($internal_node_path);

      if (
        $referer_path !== $current_path &&
        $referer_path !== $internal_node_path &&
        $referer_path !== $current_alias
      ) {
        $session->set('asocolderma_inscription.solicitud_return_url', $referer_path);
      }
    }
  }

  $variables['semaforo_steps'] = asocolderma_inscription_build_semaforo_steps($node);
}

/**
 * Construye el semáforo horizontal de una solicitud.
 */
function asocolderma_inscription_build_semaforo_steps(NodeInterface $node): array
{
  $current_tid = (int) ($node->get('field_state')->target_id ?? 0);
  $current_name = asocolderma_inscription_get_term_name_by_tid($current_tid) ?? '';

  $history_rows = asocolderma_inscription_get_state_history_rows((int) $node->id());

  $history_steps = [];
  $has_rejected = asocolderma_inscription_is_cancelled_state($current_name);

  foreach ($history_rows as $row) {
    $state_name = asocolderma_inscription_get_term_name_by_tid((int) $row->to_tid);

    if (!$state_name) {
      continue;
    }

    $label = asocolderma_inscription_map_current_state_to_flow_label($state_name);

    $history_steps[] = [
      'label' => $label,
      'status' => 'done',
      'date' => \Drupal::service('date.formatter')->format((int) $row->created, 'custom', 'd/m/Y h:i A'),
      'note' => trim((string) ($row->comment ?? '')),
      'state_name' => $state_name,
      'origin' => (string) ($row->origin ?? ''),
      'history_id' => (int) $row->id,
    ];
  }

  if (empty($history_steps)) {
    $history_steps[] = [
      'label' => asocolderma_inscription_map_current_state_to_flow_label($current_name),
      'status' => asocolderma_inscription_is_cancelled_state($current_name) ? 'cancelled' : 'current',
      'date' => \Drupal::service('date.formatter')->format($node->getCreatedTime(), 'custom', 'd/m/Y h:i A'),
      'note' => '',
      'state_name' => $current_name,
      'origin' => 'current_node_state',
      'history_id' => 0,
    ];
  }

  $last_index = count($history_steps) - 1;

  foreach ($history_steps as $index => &$step) {
    if ($index === $last_index) {
      $step['status'] = $has_rejected ? 'cancelled' : 'current';
    } else {
      $step['status'] = 'done';
    }
  }
  unset($step);

  $last_visible_label = $history_steps[$last_index]['label'] ?? asocolderma_inscription_map_current_state_to_flow_label($current_name);
  $future_steps = asocolderma_inscription_get_future_flow_steps($last_visible_label, $current_name);

  return array_merge($history_steps, $future_steps);
}

function asocolderma_inscription_get_state_history_rows(int $nid): array
{
  $connection = \Drupal::database();

  $query = $connection->select('asocolderma_solicitud_historial', 'h');
  $query->fields('h', [
    'id',
    'to_tid',
    'created',
    'origin',
    'comment',
  ]);
  $query->condition('h.solicitud_nid', $nid);
  $query->orderBy('h.created', 'ASC');
  $query->orderBy('h.id', 'ASC');

  return $query->execute()->fetchAll();
}

function asocolderma_inscription_get_future_flow_steps(string $last_visible_label, string $current_name): array
{
  if (asocolderma_inscription_is_cancelled_state($current_name)) {
    return [];
  }

  $base_flow = [
    'En trámite',
    'Aprobada',
    'Junta directiva',
    'Asamblea general',
    'Pago de ingreso',
    'Firma de documentos',
    'Aprobación documentos firmados',
    'Miembro activo',
  ];

  $last_index = array_search($last_visible_label, $base_flow, TRUE);

  if ($last_index === FALSE) {
    return [];
  }

  $future_labels = array_slice($base_flow, $last_index + 1);

  $steps = [];

  foreach ($future_labels as $label) {
    $steps[] = [
      'label' => $label,
      'status' => 'pending',
      'date' => '',
      'note' => '',
      'state_name' => '',
      'origin' => 'future',
      'history_id' => 0,
    ];
  }

  return $steps;
}

/**
 * Devuelve el flujo visible del semáforo según el estado actual.
 */
function asocolderma_inscription_get_visible_flow(string $current_name): array
{
  $later_flow = [
    'Junta directiva',
    'Asamblea general',
    'Pago de ingreso',
    'Firma de documentos',
    'Aprobación documentos firmados',
    'Miembro activo',
  ];

  $flow = ['En trámite'];

  switch ($current_name) {
    case 'Pendiente aclaración':
      $flow[] = 'Pendiente aclaración';
      break;

    case 'Rechazada':
      $flow[] = 'Rechazada';
      break;

    default:
      $flow[] = 'Aprobada';
      break;
  }

  return array_merge($flow, $later_flow);
}

/**
 * Mapea el estado actual real al label del nodo del semáforo.
 */
function asocolderma_inscription_map_current_state_to_flow_label(string $current_name): string
{
  return match ($current_name) {
    'En trámite' => 'En trámite',
    'Pendiente aclaración' => 'Pendiente aclaración',
    'Rechazada' => 'Rechazada',

    'Aprobada' => 'Aprobada',
    'Aprobado Junta D.',
    'Rechazado Junta D.' => 'Junta directiva',

    'Aprobado Asamblea G.',
    'Rechazado Asamblea G.' => 'Asamblea general',

    'Pendiente pago de ingreso' => 'Pago de ingreso',
    'Pendiente firma de documentos' => 'Firma de documentos',
    'Documentos firmados' => 'Aprobación documentos firmados',
    'Miembro activo' => 'Miembro activo',

    default => 'En trámite',
  };
}

/**
 * Indica si el estado actual es de rechazo/cancelación.
 */
function asocolderma_inscription_is_cancelled_state(string $current_name): bool
{
  $cancelled_states = [
    'Rechazada',
    'Rechazado Junta D.',
    'Rechazado Asamblea G.',
  ];

  return in_array($current_name, $cancelled_states, TRUE);
}

/**
 * Devuelve los nombres de estados recorridos por la solicitud, en orden cronológico.
 */
function asocolderma_inscription_get_state_history_names(int $nid): array
{
  $connection = \Drupal::database();

  $query = $connection->select('asocolderma_solicitud_historial', 'h');
  $query->fields('h', ['to_tid', 'created']);
  $query->condition('solicitud_nid', $nid);
  $query->orderBy('created', 'ASC');
  $query->orderBy('id', 'ASC');

  $results = $query->execute()->fetchAll();

  $names = [];

  foreach ($results as $row) {
    $name = asocolderma_inscription_get_term_name_by_tid((int) $row->to_tid);
    if ($name) {
      $names[] = $name;
    }
  }

  return array_values(array_unique($names));
}

/**
 * Devuelve la primera fecha en que la solicitud llegó a un estado del flujo.
 */
function asocolderma_inscription_get_first_date_for_state(int $nid, string $state_name): string
{
  $tid = asocolderma_inscription_get_tid_by_term_name('estado_solicitud_ingreso', $state_name);

  if (!$tid) {
    return '';
  }

  $connection = \Drupal::database();

  $query = $connection->select('asocolderma_solicitud_historial', 'h');
  $query->fields('h', ['created']);
  $query->condition('solicitud_nid', $nid);
  $query->condition('to_tid', $tid);
  $query->orderBy('created', 'ASC');
  $query->range(0, 1);

  $created = $query->execute()->fetchField();

  if (!$created) {
    return '';
  }

  return \Drupal::service('date.formatter')->format((int) $created, 'custom', 'd/m/Y');
}

/**
 * Devuelve el nombre del término por tid.
 */
function asocolderma_inscription_get_term_name_by_tid(int $tid): ?string
{
  if ($tid <= 0) {
    return NULL;
  }

  $term = Term::load($tid);
  return $term ? (string) $term->getName() : NULL;
}

/**
 * Busca un tid por nombre dentro de un vocabulario.
 */
function asocolderma_inscription_get_tid_by_term_name(string $vid, string $name): ?int
{
  $terms = \Drupal::entityTypeManager()
    ->getStorage('taxonomy_term')
    ->loadByProperties([
      'vid' => $vid,
      'name' => $name,
    ]);

  if (!$terms) {
    return NULL;
  }

  $term = reset($terms);
  return $term ? (int) $term->id() : NULL;
}

/**
 * Mapea el estado rechazado al paso del flujo que debe quedar en rojo.
 */
function asocolderma_inscription_get_cancelled_from_state(string $current_name): ?string
{
  return match ($current_name) {
    'Rechazada' => 'Aprobada',
    'Rechazado Junta D.' => 'Aprobado Junta D.',
    'Rechazado Asamblea G.' => 'Aprobado Asamblea G.',
    default => NULL,
  };
}

/**
 * Devuelve la fecha a mostrar para un paso del semáforo.
 */
function asocolderma_inscription_get_date_for_step(NodeInterface $node, string $step_label, string $current_name): string
{
  $history = asocolderma_inscription_get_state_history_names_with_dates((int) $node->id());

  $state_names_for_step = match ($step_label) {
    'En trámite' => ['En trámite'],
    'Pendiente aclaración' => ['Pendiente aclaración'],
    'Rechazada' => ['Rechazada'],
    'Aprobada' => ['Aprobada'],
    'Junta directiva' => ['Aprobado Junta D.', 'Rechazado Junta D.'],
    'Asamblea general' => ['Aprobado Asamblea G.', 'Rechazado Asamblea G.'],
    'Pago de ingreso' => ['Pendiente pago de ingreso'],
    'Firma de documentos' => ['Pendiente firma de documentos'],
    'Aprobación documentos firmados' => ['Documentos firmados'],
    'Miembro activo' => ['Miembro activo'],
    default => [],
  };

  foreach ($state_names_for_step as $state_name) {
    if (!empty($history[$state_name])) {
      return $history[$state_name];
    }
  }

  if ($step_label === asocolderma_inscription_map_current_state_to_flow_label($current_name)) {
    return \Drupal::service('date.formatter')->format($node->getCreatedTime(), 'custom', 'd/m/Y h:i A');
  }

  return '';
}

/**
 * Devuelve el histórico de estados con su primera fecha, indexado por nombre.
 */
function asocolderma_inscription_get_state_history_names_with_dates(int $nid): array
{
  $connection = \Drupal::database();

  $query = $connection->select('asocolderma_solicitud_historial', 'h');
  $query->fields('h', ['to_tid', 'created']);
  $query->condition('solicitud_nid', $nid);
  $query->orderBy('created', 'ASC');
  $query->orderBy('id', 'ASC');

  $results = $query->execute()->fetchAll();

  $history = [];

  foreach ($results as $row) {
    $name = asocolderma_inscription_get_term_name_by_tid((int) $row->to_tid);

    if ($name && empty($history[$name])) {
      $history[$name] = \Drupal::service('date.formatter')->format((int) $row->created, 'custom', 'd/m/Y');
    }
  }

  return $history;
}

/**
 * Implements hook_entity_update().
 */
function asocolderma_inscription_entity_update(\Drupal\Core\Entity\EntityInterface $entity): void
{
  if ($entity->getEntityTypeId() !== 'taxonomy_term') {
    return;
  }

  if (!$entity instanceof \Drupal\taxonomy\TermInterface) {
    return;
  }

  if ($entity->bundle() !== 'estado_solicitud_ingreso') {
    return;
  }

  \Drupal\Core\Cache\Cache::invalidateTags([
    'asocolderma_estado_solicitud_colors',
  ]);
}

/**
 * Implements hook_entity_insert().
 */
function asocolderma_inscription_entity_insert(\Drupal\Core\Entity\EntityInterface $entity): void
{
  if ($entity->getEntityTypeId() !== 'taxonomy_term') {
    return;
  }

  if (!$entity instanceof \Drupal\taxonomy\TermInterface) {
    return;
  }

  if ($entity->bundle() !== 'estado_solicitud_ingreso') {
    return;
  }

  \Drupal\Core\Cache\Cache::invalidateTags([
    'asocolderma_estado_solicitud_colors',
  ]);
}

/**
 * Implements hook_entity_delete().
 */
function asocolderma_inscription_entity_delete(\Drupal\Core\Entity\EntityInterface $entity): void
{
  if ($entity->getEntityTypeId() !== 'taxonomy_term') {
    return;
  }

  if (!$entity instanceof \Drupal\taxonomy\TermInterface) {
    return;
  }

  if ($entity->bundle() !== 'estado_solicitud_ingreso') {
    return;
  }

  \Drupal\Core\Cache\Cache::invalidateTags([
    'asocolderma_estado_solicitud_colors',
  ]);
}

/**
 * Implements hook_page_attachments().
 */
function asocolderma_inscription_page_attachments(array &$attachments): void
{
  $attachments['#attached']['library'][] = 'asocolderma_inscription/navbar_margin_top';
}

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function asocolderma_inscription_preprocess_html(array &$variables): void
{
  $current_user = \Drupal::currentUser();
  $path = \Drupal::service('path.current')->getPath();

  if ($current_user->isAuthenticated() && in_array('aspirante', $current_user->getRoles(), TRUE)) {
    $variables['attributes']['class'][] = 'asocolderma-role-aspirante';

    $variables['#attached']['library'][] = 'asocolderma_inscription/aspirante_header';
    $variables['#cache']['contexts'][] = 'user.roles';
  }

  if ($path === '/zona' || str_starts_with($path, '/zona/')) {
    $variables['attributes']['class'][] = 'asocolderma-inscription-zone-page';

    $variables['#attached']['library'][] = 'asocolderma_inscription/user_zone';
    $variables['#cache']['contexts'][] = 'url.path';
  }
}

/**
 * Implements hook_ENTITY_TYPE_access() for block entities.
 *
 * Bloquea todos los bloques del sitio público dentro del flujo del aspirante.
 */
function asocolderma_inscription_block_access(BlockInterface $block, $operation, AccountInterface $account): AccessResult
{
  if ($operation !== 'view') {
    return AccessResult::neutral();
  }

  $path = \Drupal::service('path.current')->getPath();

  if ($path === '/zona' || str_starts_with($path, '/zona/')) {
    return AccessResult::forbidden()
      ->addCacheContexts(['url.path']);
  }

  return AccessResult::neutral()
    ->addCacheContexts(['url.path']);
}

/**
 * Implements hook_page_top().
 *
 * Renderiza el header propio del flujo de aspirantes en todas las rutas /zona.
 */
function asocolderma_inscription_page_top(array &$page_top): void
{
  $path = \Drupal::service('path.current')->getPath();
  $current_user = \Drupal::currentUser();

  if (!$current_user->isAuthenticated()) {
    return;
  }

  if (!in_array('aspirante', $current_user->getRoles(), TRUE)) {
    return;
  }

  if ($path !== '/zona' && !str_starts_with($path, '/zona/')) {
    return;
  }

  $page_top['asocolderma_inscription_user_zone_header'] = [
    '#theme' => 'asocolderma_inscription_user_zone_header',
    '#menu_items' => asocolderma_inscription_build_aspirante_menu_items(),
    '#logout_url' => \Drupal\Core\Url::fromRoute('user.logout')->toString(),
    '#attached' => [
      'library' => [
        'asocolderma_inscription/user_zone',
      ],
    ],
    '#cache' => [
      'contexts' => [
        'user.roles',
        'url.path',
        'route',
      ],
    ],
  ];
}

/**
 * Construye los ítems del menú Drupal account-aspirante.
 */
function asocolderma_inscription_build_aspirante_menu_items(): array
{
  $menu_name = 'account-aspirante';
  $menu_tree = \Drupal::menuTree();

  $parameters = $menu_tree->getCurrentRouteMenuTreeParameters($menu_name);
  $parameters->onlyEnabledLinks();
  $parameters->setMinDepth(1);
  $parameters->setMaxDepth(1);

  $tree = $menu_tree->load($menu_name, $parameters);

  $tree = $menu_tree->transform($tree, [
    ['callable' => 'menu.default_tree_manipulators:checkAccess'],
    ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
  ]);

  $items = [];

  foreach ($tree as $element) {
    if (!$element->access->isAllowed()) {
      continue;
    }

    $url = $element->link->getUrlObject();
    $url_string = $url->toString();

    $items[] = [
      'title' => $element->link->getTitle(),
      'url' => $url_string,
      'active' => (bool) $element->inActiveTrail,
      'is_logout' => $element->link->getRouteName() === 'user.logout' || str_contains($url_string, '/user/logout'),
    ];
  }

  return $items;
}
