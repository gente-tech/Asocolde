<?php

/**
 * @file
 * Install, update and uninstall functions for AsoColDerma Data Core.
 */

/**
 * Implements hook_schema().
 */
function asocolderma_data_core_schema()
{
	$schema['asocolderma_import_batch'] = [
		'description' => 'Stores metadata for massive CSV import batches.',
		'fields' => [
			'id' => [
				'description' => 'Primary key of the import batch.',
				'type' => 'serial',
				'unsigned' => TRUE,
				'not null' => TRUE,
			],
			'import_type' => [
				'description' => 'Type of data being imported.',
				'type' => 'varchar',
				'length' => 64,
				'not null' => TRUE,
			],
			'filename' => [
				'description' => 'Original uploaded filename.',
				'type' => 'varchar',
				'length' => 255,
				'not null' => FALSE,
			],
			'status' => [
				'description' => 'Current status of the import batch.',
				'type' => 'varchar',
				'length' => 32,
				'not null' => TRUE,
				'default' => 'uploaded',
			],
			'total_records' => [
				'description' => 'Total records detected in the file.',
				'type' => 'int',
				'unsigned' => TRUE,
				'not null' => TRUE,
				'default' => 0,
			],
			'valid_records' => [
				'description' => 'Total valid records after validation.',
				'type' => 'int',
				'unsigned' => TRUE,
				'not null' => TRUE,
				'default' => 0,
			],
			'error_records' => [
				'description' => 'Total records with validation errors.',
				'type' => 'int',
				'unsigned' => TRUE,
				'not null' => TRUE,
				'default' => 0,
			],
			'created_by' => [
				'description' => 'User ID who uploaded the file.',
				'type' => 'int',
				'unsigned' => TRUE,
				'not null' => TRUE,
			],
			'created' => [
				'description' => 'Unix timestamp when the batch was created.',
				'type' => 'int',
				'unsigned' => TRUE,
				'not null' => TRUE,
			],
			'changed' => [
				'description' => 'Unix timestamp when the batch was last updated.',
				'type' => 'int',
				'unsigned' => TRUE,
				'not null' => TRUE,
			],
		],
		'primary key' => ['id'],
		'indexes' => [
			'import_type' => ['import_type'],
			'status' => ['status'],
			'created_by' => ['created_by'],
			'created' => ['created'],
		],
	];

	$schema['asocolderma_audit_event'] = [
		'description' => 'Stores global audit events for AsoColDerma data operations.',
		'fields' => [
			'id' => [
				'type' => 'serial',
				'unsigned' => TRUE,
				'not null' => TRUE,
			],
			'event_type' => [
				'type' => 'varchar',
				'length' => 50,
				'not null' => TRUE,
			],
			'source' => [
				'type' => 'varchar',
				'length' => 50,
				'not null' => TRUE,
			],
			'target_table' => [
				'type' => 'varchar',
				'length' => 100,
				'not null' => FALSE,
			],
			'target_record_id' => [
				'type' => 'int',
				'unsigned' => TRUE,
				'not null' => FALSE,
			],
			'target_record_label' => [
				'type' => 'varchar',
				'length' => 255,
				'not null' => FALSE,
			],
			'user_id' => [
				'type' => 'int',
				'unsigned' => TRUE,
				'not null' => TRUE,
			],
			'user_name' => [
				'type' => 'varchar',
				'length' => 150,
				'not null' => FALSE,
			],
			'user_email' => [
				'type' => 'varchar',
				'length' => 150,
				'not null' => FALSE,
			],
			'user_roles' => [
				'type' => 'text',
				'size' => 'normal',
				'not null' => FALSE,
			],
			'user_permissions_snapshot' => [
				'type' => 'text',
				'size' => 'big',
				'not null' => FALSE,
			],
			'ip_address' => [
				'type' => 'varchar',
				'length' => 45,
				'not null' => FALSE,
			],
			'user_agent' => [
				'type' => 'text',
				'size' => 'normal',
				'not null' => FALSE,
			],
			'request_uri' => [
				'type' => 'varchar',
				'length' => 500,
				'not null' => FALSE,
			],
			'created' => [
				'type' => 'int',
				'unsigned' => TRUE,
				'not null' => TRUE,
			],
			'context' => [
				'type' => 'text',
				'size' => 'big',
				'not null' => FALSE,
			],
		],
		'primary key' => ['id'],
		'indexes' => [
			'event_type' => ['event_type'],
			'source' => ['source'],
			'target_table' => ['target_table'],
			'target_record_id' => ['target_record_id'],
			'user_id' => ['user_id'],
			'created' => ['created'],
		],
	];

	return $schema;
}

/**
 * Create import batch table for CSV processing.
 */
function asocolderma_data_core_update_10001()
{
	$schema = \Drupal::database()->schema();

	if (!$schema->tableExists('asocolderma_import_batch')) {
		$table = asocolderma_data_core_schema();
		$schema->createTable('asocolderma_import_batch', $table['asocolderma_import_batch']);
	}
}

/**
 * Create audit event table.
 */
function asocolderma_data_core_update_10002()
{
	$schema = \Drupal::database()->schema();

	if (!$schema->tableExists('asocolderma_audit_event')) {
		$tables = asocolderma_data_core_schema();
		$schema->createTable('asocolderma_audit_event', $tables['asocolderma_audit_event']);
	}
}
