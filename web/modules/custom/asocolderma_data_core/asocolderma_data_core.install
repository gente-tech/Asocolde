/**
 * Add active/disabled status fields to imported data tables.
 */
function asocolderma_data_core_update_10013()
{
	$schema = \Drupal::database()->schema();

	$tables = [
		'asocolderma_import_patrocinadores',
		'asocolderma_import_asociados',
		'asocolderma_import_residentes',
		'asocolderma_import_proveedores',
		'asocolderma_import_empleados',
	];

	$fields = [
		'is_active' => [
			'description' => 'Indicates whether the record is active or disabled.',
			'type' => 'int',
			'size' => 'tiny',
			'unsigned' => TRUE,
			'not null' => TRUE,
			'default' => 1,
		],
		'status_changed' => [
			'description' => 'Unix timestamp when the active status was last changed.',
			'type' => 'int',
			'unsigned' => TRUE,
			'not null' => FALSE,
		],
		'status_changed_by' => [
			'description' => 'User ID who last changed the active status.',
			'type' => 'int',
			'unsigned' => TRUE,
			'not null' => FALSE,
		],
		'status_change_reason' => [
			'description' => 'Reason or context of the latest active status change.',
			'type' => 'text',
			'size' => 'normal',
			'not null' => FALSE,
		],
	];

	foreach ($tables as $table) {
		if (!$schema->tableExists($table)) {
			continue;
		}

		foreach ($fields as $field_name => $field_definition) {
			if (!$schema->fieldExists($table, $field_name)) {
				$schema->addField($table, $field_name, $field_definition);
			}
		}

		if (!$schema->indexExists($table, 'is_active')) {
			$table_spec = [
				'fields' => [
					'is_active' => [
						'type' => 'int',
						'size' => 'tiny',
						'unsigned' => TRUE,
						'not null' => TRUE,
						'default' => 1,
					],
				],
				'indexes' => [
					'is_active' => ['is_active'],
				],
			];

			$schema->addIndex($table, 'is_active', ['is_active'], $table_spec);
		}
	}
}

/**
 * Create import tracking log tables.
 */
function asocolderma_data_core_update_10014()
{
	$schema = \Drupal::database()->schema();
	$module_schema = asocolderma_data_core_schema();

	if (!$schema->tableExists('asocolderma_data_import_log')) {
		$schema->createTable('asocolderma_data_import_log', $module_schema['asocolderma_data_import_log']);
	}

	if (!$schema->tableExists('asocolderma_data_import_log_item')) {
		$schema->createTable('asocolderma_data_import_log_item', $module_schema['asocolderma_data_import_log_item']);
	}
}
