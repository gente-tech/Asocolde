			],
			'user_agent' => [
				'description' => 'Browser or client user agent used during import.',
				'type' => 'text',
				'size' => 'normal',
				'not null' => FALSE,
			],
			'created' => [
				'description' => 'Unix timestamp when the import process was created.',
				'type' => 'int',
				'unsigned' => TRUE,
				'not null' => TRUE,
			],
			'finished' => [
				'description' => 'Unix timestamp when the import process finished.',
				'type' => 'int',
				'unsigned' => TRUE,
				'not null' => FALSE,
			],
			'duration_seconds' => [
				'description' => 'Total import duration in seconds.',
				'type' => 'int',
				'unsigned' => TRUE,
				'not null' => FALSE,
			],
		],
		'primary key' => ['id'],
		'unique keys' => [
			'import_uuid' => ['import_uuid'],
		],
		'indexes' => [
			'uid' => ['uid'],
			'target_label' => ['target_label'],
			'status' => ['status'],
			'created' => ['created'],
		],
	];

	$schema['asocolderma_data_import_log_item'] = [
		'description' => 'Stores row-level details for data import processes.',
		'fields' => [
			'id' => [
				'description' => 'Primary key of the import log item.',
				'type' => 'serial',
				'unsigned' => TRUE,
				'not null' => TRUE,
			],
			'import_uuid' => [
				'description' => 'Unique identifier of the related import process.',
				'type' => 'varchar',
				'length' => 64,
				'not null' => TRUE,
			],
			'row_number' => [
				'description' => 'Source row number from the imported file.',
				'type' => 'int',
				'unsigned' => TRUE,
				'not null' => FALSE,
			],
			'reference_label' => [
				'description' => 'Main readable reference of the imported record.',
				'type' => 'varchar',
				'length' => 255,
				'not null' => FALSE,
			],
			'reference_document' => [
				'description' => 'Document number, NIT or secondary identifier of the imported record.',
				'type' => 'varchar',
				'length' => 100,
				'not null' => FALSE,
			],
			'target_record_id' => [
				'description' => 'ID of the inserted or updated destination record.',
				'type' => 'int',
				'unsigned' => TRUE,
				'not null' => FALSE,
			],
			'operation' => [
				'description' => 'Operation performed for the row: insert, update, skip or error.',
				'type' => 'varchar',
				'length' => 32,
				'not null' => TRUE,
				'default' => 'insert',
			],
			'status' => [
				'description' => 'Processing status of the row: success, failed, warning or skipped.',
				'type' => 'varchar',
				'length' => 32,
				'not null' => TRUE,
				'default' => 'success',
			],
			'message' => [
				'description' => 'Specific result message for the processed row.',
				'type' => 'text',
				'size' => 'normal',
				'not null' => FALSE,
			],
			'created' => [
				'description' => 'Unix timestamp when the row log was created.',
				'type' => 'int',
				'unsigned' => TRUE,
				'not null' => TRUE,
			],
		],
		'primary key' => ['id'],
		'indexes' => [
			'import_uuid' => ['import_uuid'],
			'reference_label' => ['reference_label'],
			'reference_document' => ['reference_document'],
			'target_record_id' => ['target_record_id'],
			'operation' => ['operation'],
			'status' => ['status'],
			'created' => ['created'],
		],
	];

	return $schema;
}

/**
 * Create import batch table for CSV processing.
 */
function asocolderma_data_core_update_10001()
{
	$schema = \Drupal::database()->schema();

	if (!$schema->tableExists('asocolderma_import_batch')) {
		$table = asocolderma_data_core_schema();
		$schema->createTable('asocolderma_import_batch', $table['asocolderma_import_batch']);
	}
}

