<?php

/**
 * Implements hook_preprocess_views_view_table().
 */
function asocolderma_data_core_preprocess_views_view_table(array &$variables)
{
	$view = $variables['view'];

	if ($view->id() !== 'asocolderma_patrocinadores') {
		return;
	}

	$variables['asocolderma_export_actions'] = [
		'#type' => 'container',
		'#attributes' => [
			'class' => ['asocolderma-export-actions'],
		],
		'label' => [
			'#markup' => '<span>No items selected</span>',
		],
		'select' => [
			'#type' => 'select',
			'#options' => [
				'' => '- Seleccionar -',
				'pdf' => 'Exportar PDF',
			],
			'#attributes' => [
				'class' => ['asocolderma-export-actions__select'],
			],
		],
		'button' => [
			'#type' => 'button',
			'#value' => t('Aplicar a los elementos seleccionados'),
			'#attributes' => [
				'class' => ['button', 'button--primary'],
			],
		],
	];
}
