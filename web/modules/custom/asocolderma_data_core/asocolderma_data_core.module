<?php

use Drupal\Component\Utility\Html;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;
use Drupal\user\Entity\User;

/**
 * Implements hook_page_attachments().
 */
function asocolderma_data_core_page_attachments(array &$attachments)
{
	if (!asocolderma_data_core_is_gestion_data_route()) {
		return;
	}

	$current_user = \Drupal::currentUser();

	$can_admin = $current_user->hasPermission('administer asocolderma data core');
	$can_audit = $current_user->hasPermission('audit asocolderma data core');
	$can_view = $current_user->hasPermission('view asocolderma data core');

	if (!$can_admin && !$can_audit && !$can_view) {
		return;
	}

	$attachments['#attached']['library'][] = 'asocolderma_data_core/export_actions';
	$attachments['#attached']['library'][] = 'asocolderma_data_core/record_context_menu';

	$attachments['#attached']['drupalSettings']['asocoldermaDataCore'] = [
		'permissions' => [
			'canAdmin' => $can_admin,
			'canAudit' => $can_audit,
			'canView' => $can_view,
		],
		'routes' => [
			'bulkStatusUrl' => Url::fromRoute('asocolderma_data_core.bulk_status')->toString(),
			'bulkDeleteUrl' => Url::fromRoute('asocolderma_data_core.bulk_delete')->toString(),
			'exports' => [
				'patrocinadores' => Url::fromRoute('asocolderma_data_core.export_patrocinadores_excel')->toString(),
				'proveedores' => Url::fromRoute('asocolderma_data_core.proveedores_export_excel')->toString(),
				'asociados' => Url::fromRoute('asocolderma_data_core.asociados_export_excel')->toString(),
				'residentes' => Url::fromRoute('asocolderma_data_core.residentes_export_excel')->toString(),
				'empleados' => Url::fromRoute('asocolderma_data_core.empleados_export_excel')->toString(),
			],
			'edit' => [
				'proveedores' => '/gestion-data/proveedores',
				'patrocinadores' => '/gestion-data/patrocinadores',
				'asociados' => '/gestion-data/asociados',
				'residentes' => '/gestion-data/residentes',
				'empleados' => '/gestion-data/empleados',
			],
		],
	];
}

/**
 * Implements hook_page_top().
 *
 * Adds a fixed visual header for Data Core operational pages.
 */
function asocolderma_data_core_page_top(array &$page_top)
{
	if (!asocolderma_data_core_is_gestion_data_route()) {
		return;
	}

	$current_user = \Drupal::currentUser();

	$can_admin = $current_user->hasPermission('administer asocolderma data core');
	$can_audit = $current_user->hasPermission('audit asocolderma data core');
	$can_view = $current_user->hasPermission('view asocolderma data core');

	if (!$can_admin && !$can_audit && !$can_view) {
		return;
	}

	$username = Html::escape($current_user->getDisplayName());

	$module_path = \Drupal::service('extension.list.module')->getPath('asocolderma_data_core');
	$logo_url = base_path() . $module_path . '/images/logo-horizontal-pequeno.jpg';

	$current_path = \Drupal::service('path.current')->getPath();

	$main_links = [];
	$audit_links = [];

	/*
	* Tablas principales:
	* - Admin Data: puede verlas.
	* - Operador Data: puede verlas.
	* - Auditor Data: puede verlas.
	*
	* El auditor debe tener el mismo menú visual que el operador.
	*/
	if ($can_admin || $can_view || $can_audit) {
		$main_links = [
			'Patrocinadores' => '/gestion-data/patrocinadores',
			'Proveedores' => '/gestion-data/proveedores',
			'Asociados' => '/gestion-data/asociados',
			'Residentes' => '/gestion-data/residentes',
			'Empleados' => '/gestion-data/empleados',
		];
	}

	/*
	* Auditoría:
	* - Solo Admin Data.
	*
	* Aunque exista el permiso de auditoría, el menú visual no debe mostrar
	* las tablas de auditoría al rol auditor_data_asocolderma.
	*/
	if ($can_admin) {
		$audit_links = [
			'Auditoría eventos' => '/gestion-data/auditoria/eventos',
			'Auditoría cambios' => '/gestion-data/auditoria/cambios-registros',
			'Auditoría acciones' => '/gestion-data/auditoria/acciones-registros',
			'Auditoría exportaciones' => '/gestion-data/auditoria/exportaciones',
			'Auditoría importaciones' => '/gestion-data/auditoria/importaciones',
			'Detalle importación' => '/gestion-data/auditoria/importaciones/detalle',
			'Cambios importación' => '/gestion-data/auditoria/importaciones/cambios',
		];
	}

	$import_url = NULL;

	/*
	* Importación:
	* - Solo Admin Data.
	*/
	if ($can_admin) {
		$import_url = Url::fromRoute('asocolderma_data_core.importacion')->toString();
	}

	$logout_url = Url::fromRoute('user.logout', [], [
		'query' => [
			'destination' => '/',
		],
	])->toString();

	$main_markup = '';
	foreach ($main_links as $label => $url) {
		$active_class = $current_path === $url ? ' is-active' : '';
		$main_markup .= '<a class="data-core-header__dropdown-link' . $active_class . '" href="' . Html::escape($url) . '">' . Html::escape($label) . '</a>';
	}

	$audit_markup = '';
	foreach ($audit_links as $label => $url) {
		$active_class = $current_path === $url ? ' is-active' : '';
		$audit_markup .= '<a class="data-core-header__dropdown-link' . $active_class . '" href="' . Html::escape($url) . '">' . Html::escape($label) . '</a>';
	}

	$import_active_class = $current_path === '/gestion-data/importacion' ? ' is-active' : '';

	$nav_markup = '';

	if (!empty($main_links)) {
		$nav_markup .= '
			<div class="data-core-header__dropdown">
				<button class="data-core-header__dropdown-button" type="button">
				Tablas principales
				<span class="data-core-header__chevron">▾</span>
				</button>
				<div class="data-core-header__dropdown-panel">
				' . $main_markup . '
				</div>
			</div>
		';
	}

	if (!empty($audit_links)) {
		$nav_markup .= '
			<div class="data-core-header__dropdown">
				<button class="data-core-header__dropdown-button" type="button">
				Auditoría
				<span class="data-core-header__chevron">▾</span>
				</button>
				<div class="data-core-header__dropdown-panel data-core-header__dropdown-panel--wide">
				' . $audit_markup . '
				</div>
			</div>
		';
	}

	if (!empty($import_url)) {
		$nav_markup .= '<a class="data-core-header__direct-link' . $import_active_class . '" href="' . Html::escape($import_url) . '">Importación</a>';
	}

	$markup = '
		<header class="data-core-header" role="banner">
			<div class="data-core-header__inner">
				<div class="data-core-header__brand">
					<a class="data-core-header__logo-link" href="/gestion-data/proveedores" aria-label="Ir a Gestión Data AsoColDerma">
						<img class="data-core-header__logo" src="' . Html::escape($logo_url) . '" alt="AsoColDerma">
					</a>
					<div class="data-core-header__brand-text">
						<div class="data-core-header__title">Gestión Data AsoColDerma</div>
						<div class="data-core-header__subtitle">Base de datos institucional</div>
					</div>
				</div>

				<nav class="data-core-header__nav" aria-label="Menú principal Gestión Data">
				' . $nav_markup . '
				</nav>

				<div class="data-core-header__user">
				<div class="data-core-header__user-info">
					<span class="data-core-header__user-label">Usuario</span>
					<span class="data-core-header__user-name">' . $username . '</span>
				</div>

				<div class="data-core-header__user-menu">
					<button class="data-core-header__user-button" type="button">
					Cuenta
					<span class="data-core-header__chevron">▾</span>
					</button>
					<div class="data-core-header__user-panel">
					<span class="data-core-header__user-panel-name">' . $username . '</span>
					<a class="data-core-header__logout" href="' . Html::escape($logout_url) . '">Cerrar sesión</a>
					</div>
				</div>
				</div>
			</div>
		</header>
	';

	$page_top['asocolderma_data_core_header'] = [
		'#type' => 'markup',
		'#markup' => $markup,
		'#allowed_tags' => [
			'header',
			'div',
			'nav',
			'button',
			'span',
			'a',
			'img',
		],
		'#attached' => [
			'library' => [
				'asocolderma_data_core/export_actions',
			],
		],
		'#weight' => -1000,
	];
}

/**
 * Checks if the current request belongs to the Data Core operational area.
 */
function asocolderma_data_core_is_gestion_data_route(): bool
{
	$path = \Drupal::service('path.current')->getPath();

	if ($path === '/gestion-data') {
		return TRUE;
	}

	return str_starts_with($path, '/gestion-data/');
}

/**
 * Retorna los roles autorizados para usar el login de Base de Datos.
 */
function asocolderma_data_core_database_login_allowed_roles(): array
{
	return [
		'admin_data_asocolderma',
		'operador_data_asocolderma',
		'auditor_data_asocolderma',
	];
}

/**
 * Valida si una cuenta pertenece a los roles de Base de Datos.
 */
function asocolderma_data_core_user_has_database_role(\Drupal\user\UserInterface $account): bool
{
	foreach (asocolderma_data_core_database_login_allowed_roles() as $role) {
		if ($account->hasRole($role)) {
			return TRUE;
		}
	}

	return FALSE;
}

/**
 * Retorna la ruta interna inicial para usuarios de Base de Datos.
 */
function asocolderma_data_core_database_default_path(): string
{
	return '/gestion-data/proveedores';
}

/**
 * Implements hook_form_FORM_ID_alter().
 *
 * Redirects data core users after login.
 */
function asocolderma_data_core_form_user_login_form_alter(array &$form, FormStateInterface $form_state, $form_id)
{
	$form['#submit'][] = 'asocolderma_data_core_user_login_redirect_submit';
}

/**
 * Custom submit handler for login redirect.
 */
function asocolderma_data_core_user_login_redirect_submit(array &$form, FormStateInterface $form_state)
{
	$uid = $form_state->get('uid');

	if (empty($uid)) {
		return;
	}

	$account = User::load($uid);

	if (!$account) {
		return;
	}

	if (
		$account->hasRole('admin_data_asocolderma') ||
		$account->hasRole('operador_data_asocolderma') ||
		$account->hasRole('auditor_data_asocolderma')
	) {
		$form_state->setRedirectUrl(Url::fromUri('internal:/gestion-data/proveedores'));
	}
}

/**
 * Implements hook_theme().
 */
function asocolderma_data_core_theme($existing, $type, $theme, $path): array
{
	return [
		'asocolderma_data_core_database_modal_login' => [
			'variables' => [
				'form' => NULL,
			],
			'template' => 'asocolderma-data-core-database-modal-login',
		],
		'asocolderma_data_core_user_login_form' => [
			'render element' => 'form',
			'template' => 'asocolderma-data-core-user-login-form',
		],
	];
}
