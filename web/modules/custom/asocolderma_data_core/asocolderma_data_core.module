<?php

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;
use Drupal\user\Entity\User;

/**
 * Implements hook_page_attachments().
 */
function asocolderma_data_core_page_attachments(array &$attachments)
{
	$route_name = \Drupal::routeMatch()->getRouteName();

	$allowed_routes = [
		'view.patrocinadores.page_1',
		'view.proveedores.page_1',
		'view.asociados.page_1',
		'view.residentes.page_1',
		'view.empleados.page_1',
	];

	if (!in_array($route_name, $allowed_routes, TRUE)) {
		return;
	}

	$current_user = \Drupal::currentUser();

	$can_admin = $current_user->hasPermission('administer asocolderma data core');
	$can_audit = $current_user->hasPermission('audit asocolderma data core');
	$can_view = $current_user->hasPermission('view asocolderma data core');

	if (!$can_admin && !$can_audit && !$can_view) {
		return;
	}

	$attachments['#attached']['library'][] = 'asocolderma_data_core/export_actions';
	$attachments['#attached']['library'][] = 'asocolderma_data_core/record_context_menu';

	$attachments['#attached']['drupalSettings']['asocoldermaDataCore'] = [
		'permissions' => [
			'canAdmin' => $can_admin,
			'canAudit' => $can_audit,
			'canView' => $can_view,
		],
		'routes' => [
			'bulkStatusUrl' => Url::fromRoute('asocolderma_data_core.bulk_status')->toString(),
			'bulkDeleteUrl' => Url::fromRoute('asocolderma_data_core.bulk_delete')->toString(),
			'exports' => [
				'patrocinadores' => Url::fromRoute('asocolderma_data_core.export_patrocinadores_excel')->toString(),
				'proveedores' => Url::fromRoute('asocolderma_data_core.proveedores_export_excel')->toString(),
				'asociados' => Url::fromRoute('asocolderma_data_core.asociados_export_excel')->toString(),
				'residentes' => Url::fromRoute('asocolderma_data_core.residentes_export_excel')->toString(),
				'empleados' => Url::fromRoute('asocolderma_data_core.empleados_export_excel')->toString(),
			],
			'edit' => [
				'proveedores' => '/gestion-data/proveedores',
			],
		],
	];
}

/**
 * Implements hook_form_FORM_ID_alter().
 *
 * Redirects data core users after login.
 */
function asocolderma_data_core_form_user_login_form_alter(array &$form, FormStateInterface $form_state, $form_id)
{
	$form['#submit'][] = 'asocolderma_data_core_user_login_redirect_submit';
}

/**
 * Custom submit handler for login redirect.
 */
function asocolderma_data_core_user_login_redirect_submit(array &$form, FormStateInterface $form_state)
{
	$uid = $form_state->get('uid');

	if (empty($uid)) {
		return;
	}

	$account = User::load($uid);

	if (!$account) {
		return;
	}

	if (
		$account->hasRole('admin_data_asocolderma') ||
		$account->hasRole('operador_data_asocolderma') ||
		$account->hasRole('auditor_data_asocolderma')
	) {
		$form_state->setRedirectUrl(Url::fromUri('internal:/gestion-data/proveedores'));
	}
}
