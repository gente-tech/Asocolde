{{ attach_library('asocolderma_b5/modal_pdf') }}

<br>
<br>

{% if semaforo_steps is not empty %}
	<div class="solicitud-semaforo-wrapper">
		<h3 class="solicitud-semaforo-title">Seguimiento de la solicitud</h3>

		<div class="solicitud-semaforo" role="list" aria-label="Estados de la solicitud">
			{% for step in semaforo_steps %}
				{% set has_note = step.note is defined and step.note|striptags|trim is not empty %}
				{% set clean_note = has_note ? step.note|striptags|trim : '' %}

				<div class="solicitud-semaforo__item solicitud-semaforo__item--{{ step.status }}{% if has_note %} solicitud-semaforo__item--has-note{% endif %}" role="listitem" {% if has_note %} title="{{ clean_note|e('html_attr') }}" data-note="{{ clean_note|e('html_attr') }}" {% endif %}>

					{% if not loop.first %}
						<div class="solicitud-semaforo__line"></div>
					{% endif %}

					<div class="solicitud-semaforo__node">
						<span class="solicitud-semaforo__dot"></span>
					</div>

					<div class="solicitud-semaforo__content">
						<div class="solicitud-semaforo__label">{{ step.label }}</div>

						{% if step.date %}
							{% set parts = step.date|split(' ') %}

							<div class="solicitud-semaforo__date">
								<span class="fecha">{{ parts[0] }}</span>

								{% if parts[1] is defined %}
									<span class="hora">
										{{ parts[1] }}
										{% if parts[2] is defined %}
											{{ parts[2] }}
										{% endif %}
									</span>
								{% endif %}
							</div>
						{% endif %}

						{% if has_note %}
							<div class="solicitud-semaforo__note-indicator">
								Ver motivo
							</div>
						{% endif %}
					</div>
				</div>
			{% endfor %}
		</div>
	</div>
{% endif %}

<br>

{% set estado_entity = node.field_state.entity %}
{% set estado = estado_entity ? estado_entity.label : '' %}

{% if estado == 'Documentos firmados' %}

	<div class="solicitud-documento-firmado">
		<h3>Documento firmado</h3>

		<a href="{{ path('asocolderma_inscription.solicitud_signed_document', {'node': node.id}) }}" class="button button--primary" target="_blank">
			Ver documento
		</a>
	</div>

{% endif %}

<section class="solicitud-ingreso">

	<div class="solicitud-ingreso__header">
		<h1>Solicitud de ingreso</h1>

		<p>
			<strong>ID Solicitud:</strong>
			{{ node.field_solicitud_id.value ?: '-' }}
		</p>

		<p>
			<strong>Estado:</strong>
			{{ estado ?: '-' }}
		</p>

		<p>
			<strong>Aceptó términos:</strong>
			{{ node.field_terms_accepted is defined ? (node.field_terms_accepted.value ? 'Sí' : 'No') : '-' }}
		</p>
	</div>
	{% if logged_in and ('secretaria_general' in user.getRoles or 'coordinacion_administrativa' in user.getRoles) %}
		<div class="solicitud-ingreso__header">
			{{ drupal_form('Drupal\\asocolderma_inscription\\Form\\SolicitudStateInlineForm', node.id) }}
		</div>
	{% endif %}


	<div class="solicitud-ingreso__body">

		<div class="solicitud-ingreso__section">
			<h2>Información general</h2>

			<p>
				<strong>Tipo de asociado:</strong>
				{{ node.field_tipo_asociado.entity ? node.field_tipo_asociado.entity.label : '-' }}
			</p>

			<p>
				<strong>Primer nombre:</strong>
				{{ node.field_nombre1.value ?: '-' }}
			</p>

			<p>
				<strong>Segundo nombre:</strong>
				{{ node.field_nombre2.value ?: '-' }}
			</p>

			<p>
				<strong>Primer apellido:</strong>
				{{ node.field_apellido1.value ?: '-' }}
			</p>

			<p>
				<strong>Segundo apellido:</strong>
				{{ node.field_apellido2.value ?: '-' }}
			</p>

			<p>
				<strong>Fecha de nacimiento:</strong>
				{{ node.field_fecha_nacimiento.value ? node.field_fecha_nacimiento.value|date('Y-m-d') : '-' }}
			</p>

			<p>
				<strong>Estado civil:</strong>
				{{ node.field_estado_civil.entity ? node.field_estado_civil.entity.label : '-' }}
			</p>

			<p>
				<strong>Sexo:</strong>
				{{ node.field_sexo.entity ? node.field_sexo.entity.label : '-' }}
			</p>

			<p>
				<strong>Tipo de documento:</strong>
				{{ node.field_tipo_documento.entity ? node.field_tipo_documento.entity.label : '-' }}
			</p>

			<p>
				<strong>Número de documento:</strong>
				{{ node.field_numero_documento.value ?: '-' }}
			</p>

			<p>
				<strong>Número Registro médico / tarjeta profesional:</strong>
				{{ node.field_registro_medico.value ?: '-' }}
			</p>

			<p>
				<strong>País:</strong>
				{{ node.field_pais.entity ? node.field_pais.entity.label : '-' }}
			</p>

			<p>
				<strong>Ciudad de ejercicio principal:</strong>
				{{ node.field_ciudad_ejercicio.entity ? node.field_ciudad_ejercicio.entity.label : '-' }}
			</p>

			<p>
				<strong>Departamento:</strong>
				{{ node.field_departamento.entity ? node.field_departamento.entity.label : '-' }}
			</p>
		</div>


		<div class="solicitud-ingreso__section">
			<h2>Información uso institucional</h2>

			<p>
				<strong>Dirección física principal:</strong>
				{{ node.field_correspondencia_fisica.value ?: '-' }}
			</p>

			<p>
				<strong>Dirección institucional:</strong>
				{{ node.field_direccion_institucional.value ?: '-' }}
			</p>

			<p>
				<strong>Correo electrónico principal:</strong>
				{{ node.field_email_principal.value ?: '-' }}
			</p>

			<p>
				<strong>Teléfono celular de contacto:</strong>
				{{ node.field_celular.value ?: '-' }}
			</p>

			<p>
				<strong>En caso de ser ratificado ¿Dónde desea recibir la correspondencia física?:</strong>
				{{ node.field_lugar_correspondencia.entity ? node.field_lugar_correspondencia.entity.label : '-' }}
			</p>
		</div>


		<section class="solicitud-section solicitud-section--academica">
			<h3>Información académica</h3>

			<div class="solicitud-grid">

				<div class="solicitud-field">
					<strong>Facultad de medicina – Pregrado</strong>
					<span>
						{{ content.field_facultad_pregrado }}
					</span>
				</div>

				<div class="solicitud-field">
					<strong>País donde realizó el pregrado en medicina</strong>
					<span>
						{{ content.field_pais_pregrado }}
					</span>
				</div>

				<div class="solicitud-field">
					<strong>Título universitario</strong>
					<span>
						{{ content.field_titulo_universitario }}
					</span>
				</div>

				<div class="solicitud-field">
					<strong>Universidad de residencia</strong>
					<span>
						{{ content.field_universidad_residencia }}
					</span>
				</div>

				<div class="solicitud-field">
					<strong>País donde realizó la residencia</strong>
					<span>
						{{ content.field_pais_residencia }}
					</span>
				</div>

				<div class="solicitud-field">
					<strong>Programa voluntario de Re-certificación médica en dermatología CAMEC</strong>
					<span>
						{% if node.field_recertificacion_camec.value == '1' %}
							Sí
						{% else %}
							No
						{% endif %}
					</span>
				</div>

				<div class="solicitud-field">
					<strong>Tiene una Subespecialidad?</strong>
					<span>
						{% if node.field_tiene_subespecialidad.value == '1' %}
							Sí
						{% else %}
							No
						{% endif %}
					</span>
				</div>

				{% if node.field_tiene_subespecialidad.value == '1' %}
					<div class="solicitud-field">
						<strong>Subespecialidad</strong>
						<span>
							{{ content.field_subespecialidad_cual }}
						</span>
					</div>
				{% endif %}

			</div>
		</section>


		<div class="solicitud-ingreso__section">
			<h2>Información societaria (Adjuntos)</h2>

			{% 	set adjuntos = [
					{'label':'Copia carta 1 de presentación', 'field':'field_adj_carta_1'},
					{'label':'Copia carta 2 de presentación', 'field':'field_adj_carta_2'},
					{'label':'Copia RUT', 'field':'field_adj_rut'},
					{'label':'Copia cédula o ID', 'field':'field_adj_id'},
					{'label':'Carta de solicitud de ingreso', 'field':'field_adj_carta_ingreso'},
					{'label':'Hoja de vida', 'field':'field_adj_hv'},
					{'label':'Copia diploma médico general', 'field':'field_adj_diploma_medico'},
					{'label':'Copia diploma dermatólogo', 'field':'field_adj_diploma_dermatologo'},
					{'label':'Registro médico / RETHUS', 'field':'field_adj_rethus'},
					{'label':'Carta autorización verificación títulos', 'field':'field_adj_aut_verificacion'},
					{'label':'Certificación conferencia/caso/póster/publicación', 'field':'field_adj_cert_publicacion'}
				] 
			%}

			<ul>
				{% set any_file = false %}
				{% for item in adjuntos %}
					{% set f = attribute(node, item.field) %}
					{% if f is not empty and f.entity %}
						{% set any_file = true %}
						<li>
							<strong>{{ item.label }}:</strong>
							<a class="btn-pdf" href="{{ file_url(f.entity.uri.value) }}">
								{{ f.entity.filename.value }}
							</a>
						</li>
					{% endif %}
				{% endfor %}
			</ul>

			{% if not any_file %}
				<p>No hay documentos adjuntos.</p>
			{% endif %}

		</div>

	</div>
</section>

<!-- Overlay + Modal -->
<div class="overlay-pdf" id="overlayPdf">
	<div class="modal-pdf" id="modalPdf">
		<div class="modal-header">
			<button id="closeBtn">Cerrar</button>
		</div>
		<div class="modal-content">
			<iframe id="pdfFrame" src=""></iframe>
		</div>
	</div>
</div>
