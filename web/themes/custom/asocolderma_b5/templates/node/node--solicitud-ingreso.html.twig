{{ attach_library('asocolderma_b5/modal_pdf') }}

<br>
<br>

{% if semaforo_steps is not empty %}
	<div class="solicitud-semaforo-wrapper">
		<h3 class="solicitud-semaforo-title">Seguimiento de la solicitud</h3>

		<div class="solicitud-semaforo" role="list" aria-label="Estados de la solicitud">
			{% for step in semaforo_steps %}
				{% set has_note = step.note is defined and step.note|striptags|trim is not empty %}
				{% set clean_note = has_note ? step.note|striptags|trim : '' %}

				<div
					class="solicitud-semaforo__item solicitud-semaforo__item--{{ step.status }}{% if has_note %} solicitud-semaforo__item--has-note{% endif %}"
					role="listitem"
					{% if has_note %}
					title="{{ clean_note|e('html_attr') }}"
					data-note="{{ clean_note|e('html_attr') }}"
					{% endif %}
				>

					{% if not loop.first %}
						<div class="solicitud-semaforo__line"></div>
					{% endif %}

					<div class="solicitud-semaforo__node">
						<span class="solicitud-semaforo__dot"></span>
					</div>

					<div class="solicitud-semaforo__content">
						<div class="solicitud-semaforo__label">
							{{ step.label }}
						</div>

						{% if step.date %}
							{% set parts = step.date|split(' ') %}

							<div class="solicitud-semaforo__date">
								<span class="fecha">
									{{ parts[0] }}
								</span>

								{% if parts[1] is defined %}
									<span class="hora">
										{{ parts[1] }}

										{% if parts[2] is defined %}
											{{ parts[2] }}
										{% endif %}
									</span>
								{% endif %}
							</div>
						{% endif %}

						{% if has_note %}
							<div class="solicitud-semaforo__note-indicator">
								Ver motivo
							</div>
						{% endif %}
					</div>
				</div>
			{% endfor %}
		</div>
	</div>
{% endif %}

<br>

{% set estado_entity = node.field_state.entity %}
{% set estado = estado_visual_solicitud ?: (estado_entity ? estado_entity.label : '') %}

{% if documento_firmado_disponible %}
	<div class="solicitud-documento-firmado">
		<h3>Documento firmado</h3>

		<a
			href="{{ path('asocolderma_inscription.solicitud_signed_document', {'node': node.id}) }}"
			class="button button--primary"
			target="_blank"
		>
			Ver documento
		</a>
	</div>
{% endif %}

<section class="solicitud-ingreso">

	<div class="solicitud-ingreso__header">
		<h1>Solicitud de ingreso</h1>

		<p>
			<strong>ID Solicitud:</strong>
			{{ node.field_solicitud_id.value ?: '-' }}
		</p>

		<p
			class="solicitud-ingreso__status-card{% if estado_color_solicitud %} solicitud-ingreso__status-card--has-color{% endif %}"
			{% if estado_color_solicitud %}
			style="--estado-color: {{ estado_color_solicitud }};"
			{% endif %}
		>
			<strong>Estado:</strong>

			{% if estado_color_solicitud %}
				<span
					class="solicitud-ingreso__status-badge estado-solicitud-color"
					data-estado-color="{{ estado_color_solicitud }}"
				>
					{{ estado ?: '-' }}
				</span>
			{% else %}
				{{ estado ?: '-' }}
			{% endif %}
		</p>

		<p>
			<strong>{{ solicitud_form_labels.confirm.terms }}:</strong>
			{{ node.field_terms_accepted is defined ? (node.field_terms_accepted.value ? 'Sí' : 'No') : '-' }}
		</p>
	</div>

	{% if logged_in and ('secretaria_general' in user.getRoles or 'coordinacion_administrativa' in user.getRoles) %}
		<div class="solicitud-ingreso__header">
			{{ drupal_form('Drupal\\asocolderma_inscription\\Form\\SolicitudStateInlineForm', node.id) }}
		</div>
	{% endif %}

	<div class="solicitud-ingreso__body">

		<div class="solicitud-ingreso__section">
			<h2>Información general</h2>

			<p>
				<strong>{{ solicitud_form_labels.general.tipo_asociado }}:</strong>
				{{ node.field_tipo_asociado.entity ? node.field_tipo_asociado.entity.label : '-' }}
			</p>

			<p>
				<strong>{{ solicitud_form_labels.general.nombre1 }}:</strong>
				{{ node.field_nombre1.value ?: '-' }}
			</p>

			<p>
				<strong>{{ solicitud_form_labels.general.nombre2 }}:</strong>
				{{ node.field_nombre2.value ?: '-' }}
			</p>

			<p>
				<strong>{{ solicitud_form_labels.general.apellido1 }}:</strong>
				{{ node.field_apellido1.value ?: '-' }}
			</p>

			<p>
				<strong>{{ solicitud_form_labels.general.apellido2 }}:</strong>
				{{ node.field_apellido2.value ?: '-' }}
			</p>

			<p>
				<strong>{{ solicitud_form_labels.general.fecha_nacimiento }}:</strong>

				{% if node.field_fecha_nacimiento.value %}
					{% set mes_nacimiento = node.field_fecha_nacimiento.value|date('n') %}

					{% set meses = {
						'1': 'Enero',
						'2': 'Febrero',
						'3': 'Marzo',
						'4': 'Abril',
						'5': 'Mayo',
						'6': 'Junio',
						'7': 'Julio',
						'8': 'Agosto',
						'9': 'Septiembre',
						'10': 'Octubre',
						'11': 'Noviembre',
						'12': 'Diciembre'
					} %}

					{{ node.field_fecha_nacimiento.value|date('j') }}
					de
					{{ meses[mes_nacimiento] }}
					de
					{{ node.field_fecha_nacimiento.value|date('Y') }}
				{% else %}
					-
				{% endif %}
			</p>

			<p>
				<strong>{{ solicitud_form_labels.general.estado_civil }}:</strong>
				{{ node.field_estado_civil.entity ? node.field_estado_civil.entity.label : '-' }}
			</p>

			<p>
				<strong>{{ solicitud_form_labels.general.sexo }}:</strong>
				{{ node.field_sexo.entity ? node.field_sexo.entity.label : '-' }}
			</p>

			<p>
				<strong>{{ solicitud_form_labels.general.tipo_documento }}:</strong>
				{{ node.field_tipo_documento.entity ? node.field_tipo_documento.entity.label : '-' }}
			</p>

			<p>
				<strong>{{ solicitud_form_labels.general.numero_documento }}:</strong>
				{{ node.field_numero_documento.value ?: '-' }}
			</p>

			<p>
				<strong>{{ solicitud_form_labels.general.registro_medico }}:</strong>
				{{ node.field_registro_medico.value ?: '-' }}
			</p>

			<p>
				<strong>{{ solicitud_form_labels.general.pais }}:</strong>
				{{ node.field_pais.entity ? node.field_pais.entity.label : '-' }}
			</p>

			<p>
				<strong>{{ solicitud_form_labels.general.ciudad_ejercicio }}:</strong>
				{{ node.field_ciudad_ejercicio.entity ? node.field_ciudad_ejercicio.entity.label : '-' }}
			</p>

			<p>
				<strong>{{ solicitud_form_labels.general.departamento }}:</strong>
				{{ node.field_departamento.entity ? node.field_departamento.entity.label : '-' }}
			</p>
		</div>

		<div class="solicitud-ingreso__section">
			<h2>Información uso institucional</h2>

			<p>
				<strong>{{ solicitud_form_labels.contacto.direccion }}:</strong>
				{{ node.field_correspondencia_fisica.value ?: '-' }}
			</p>

			<p>
				<strong>{{ solicitud_form_labels.contacto.correspondencia_fisica }}:</strong>
				{{ node.field_direccion_institucional.value ?: '-' }}
			</p>

			<p>
				<strong>{{ solicitud_form_labels.contacto.email }}:</strong>
				{{ node.field_email_principal.value ?: '-' }}
			</p>

			<p>
				<strong>{{ solicitud_form_labels.contacto.celular }}:</strong>
				{{ node.field_celular.value ?: '-' }}
			</p>

			<p>
				<strong>{{ solicitud_form_labels.contacto.lugar_correspondencia }}:</strong>
				{{ node.field_lugar_correspondencia.entity ? node.field_lugar_correspondencia.entity.label : '-' }}
			</p>
		</div>

		<section class="solicitud-section solicitud-section--academica">
			<h3>Información académica</h3>

			<div class="solicitud-grid">

				<div class="solicitud-field">
					<strong>{{ solicitud_form_labels.profesional.facultad_pregrado }}</strong>

					<span>
						{{ node.field_facultad_pregrado.entity ? node.field_facultad_pregrado.entity.label : '-' }}
					</span>
				</div>

				<div class="solicitud-field">
					<strong>{{ solicitud_form_labels.profesional.pais_pregrado }}</strong>

					<span>
						{{ node.field_pais_pregrado.entity ? node.field_pais_pregrado.entity.label : '-' }}
					</span>
				</div>

				<div class="solicitud-field">
					<strong>{{ solicitud_form_labels.profesional.titulo_universitario }}</strong>

					<span>
						{{ node.field_titulo_universitario.entity ? node.field_titulo_universitario.entity.label : '-' }}
					</span>
				</div>

				<div class="solicitud-field">
					<strong>{{ solicitud_form_labels.profesional.universidad_residencia }}</strong>

					<span>
						{{ node.field_universidad_residencia.entity ? node.field_universidad_residencia.entity.label : '-' }}
					</span>
				</div>

				<div class="solicitud-field">
					<strong>{{ solicitud_form_labels.profesional.pais_residencia }}</strong>

					<span>
						{{ node.field_pais_residencia.entity ? node.field_pais_residencia.entity.label : '-' }}
					</span>
				</div>

				<div class="solicitud-field">
					<strong>{{ solicitud_form_labels.profesional.tiene_subespecialidad }}</strong>

					<span>
						{% if node.field_tiene_subespecialidad.value == '1' %}
							Sí
						{% else %}
							No
						{% endif %}
					</span>
				</div>

				{% if node.field_tiene_subespecialidad.value == '1' %}
					<div class="solicitud-field">
						<strong>{{ solicitud_form_labels.profesional.subespecialidad_cual }}</strong>

						<span>
							{{ node.field_subespecialidad_cual.entity ? node.field_subespecialidad_cual.entity.label : '-' }}
						</span>
					</div>
				{% endif %}

			</div>
		</section>

		<div class="solicitud-ingreso__section">
			<h2>Información societaria (Adjuntos)</h2>

			{% set adjuntos = [
				{
					'label': solicitud_form_labels.adjuntos.adj_carta_1,
					'field': 'field_adj_carta_1'
				},
				{
					'label': solicitud_form_labels.adjuntos.adj_carta_2,
					'field': 'field_adj_carta_2'
				},
				{
					'label': solicitud_form_labels.adjuntos.adj_rut,
					'field': 'field_adj_rut'
				},
				{
					'label': solicitud_form_labels.adjuntos.adj_id,
					'field': 'field_adj_id'
				},
				{
					'label': solicitud_form_labels.adjuntos.adj_carta_ingreso,
					'field': 'field_adj_carta_ingreso'
				},
				{
					'label': solicitud_form_labels.adjuntos.adj_hv,
					'field': 'field_adj_hv'
				},
				{
					'label': solicitud_form_labels.adjuntos.adj_diploma_medico,
					'field': 'field_adj_diploma_medico'
				},
				{
					'label': solicitud_form_labels.adjuntos.adj_diploma_dermatologo,
					'field': 'field_adj_diploma_dermatologo'
				},
				{
					'label': solicitud_form_labels.adjuntos.adj_rethus,
					'field': 'field_adj_rethus'
				},
				{
					'label': solicitud_form_labels.adjuntos.adj_aut_verificacion,
					'field': 'field_adj_aut_verificacion'
				},
				{
					'label': solicitud_form_labels.adjuntos.adj_cert_publicacion,
					'field': 'field_adj_cert_publicacion'
				},
				{
					'label': solicitud_form_labels.adjuntos.adj_acta_grado_medico,
					'field': 'field_adj_acta_grado_medico'
				},
				{
					'label': solicitud_form_labels.adjuntos.adj_acta_grado_dermatologo,
					'field': 'field_adj_acta_grado_dermatologo'
				},
				{
					'label': solicitud_form_labels.adjuntos.adj_convalidacion,
					'field': 'field_adj_convalidacion'
				},
				{
					'label': solicitud_form_labels.adjuntos.adj_pensum_academico,
					'field': 'field_adj_pensum_academico'
				},
				{
					'label': solicitud_form_labels.adjuntos.adj_notas_dermatologia,
					'field': 'field_adj_notas_dermatologia'
				}
			] %}

			<ul>
				{% set any_file = false %}

				{% for item in adjuntos %}
					{% set f = attribute(node, item.field) %}

					{% if f is not empty and f.entity %}
						{% set any_file = true %}

						<li>
							<strong>{{ item.label }}:</strong>

							<a
								class="btn-pdf"
								href="{{ file_url(f.entity.uri.value) }}"
							>
								{{ f.entity.filename.value }}
							</a>
						</li>
					{% endif %}
				{% endfor %}
			</ul>

			{% if not any_file %}
				<p>No hay documentos adjuntos.</p>
			{% endif %}
		</div>

	</div>
</section>

<!-- Overlay + Modal -->
<div class="overlay-pdf" id="overlayPdf">
	<div class="modal-pdf" id="modalPdf">
		<div class="modal-header">
			<button id="closeBtn">
				Cerrar
			</button>
		</div>

		<div class="modal-content">
			<iframe id="pdfFrame" src=""></iframe>
		</div>
	</div>
</div>
